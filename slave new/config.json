{
    "scan_ignore": ["/sd"],
    "System": {
        "dual_core_mode": "taskmanager",
        "c_lum": 1.0,
        "hostname": "",
        "refresh_rate_ms": 1,
        "master_IP": "",
        "master_port": 0,
        "discovery_port": 9000,
        "heartbeat_interval": 10000,
        "local_fps": 40,
        "num_leds": 336,
        "buffer_frames": 1,
        "log_interval_ms": 1000
    },
    "Buffer": {
        "size": 16384,
        "rx_hub_buffers": 16,
        "drop_on_full": 1,
        "drain_reads": 1
    },
    "Network": {
        "priority": ["lan", "wifi"],
        "lan": {
            "enable": 0,
            "active_mode": 1,
            "driver": "RMII",
            "phy_addr": 1,
            "phy_type": "IP101",
            "GPIO": {
                "mdc": 31, "mdio": 52, "ref_clk": 50,
                "spi": -1, "cs": -1, "rst": -1, "int": -1
            }
        },
        "wifi": {
            "enable": 0,
            "active_mode": 2,
            "timeout": 300,
            "ssid": "Home_WiFi",
            "ssid_pw": "",
            "mdns_name": "esp32-led-"
        },
        "ESP_now": { "enable": 0, "channel": 6 }
    },
    "CircuitDecode": {
        "enable": 0,
        "list": [
            { "GPIO": { "uart": 0 } }
        ]
    },
    "Jpeg": {
        "width": 240,
        "height": 240,
        "pixel_format": "RGB565_LE",
        "loop": true,
        "pace_ms": 33,
        "default_source": "/jpeg/background"
    }

}